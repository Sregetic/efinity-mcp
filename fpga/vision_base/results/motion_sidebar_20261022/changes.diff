+  for(iy=0;iy<96;iy=iy+1)begin
+   for(ix=0;ix<192;ix=ix+1)begin @(negedge clk);de=1;x=ix;y=iy;gray=pixels[number*192*96+iy*192+ix];end
+   @(negedge clk);de=0;repeat(5)@(negedge clk);
+  end
+  repeat(50)@(negedge clk);
+ end
+endtask
